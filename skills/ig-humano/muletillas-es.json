  "estructuras": [
    {"id": "no-solo-sino", "regex": "\\bno (?:es|son|fue|fueron) (?:solo|solamente|simplemente|únicamente)\\b[^.\\n]{0,70}(?:sino|es|son)\\b", "nota": "«no es solo X, es Y»: la plantilla más reconocible de IA"},
    {"id": "pregunta-retorica-suelta", "regex": "(?m)^\\s*¿[^?\\n]{1,28}\\?\\s*$", "nota": "pregunta corta en su propia línea («¿El resultado?»)"},
    {"id": "gancho-sabias-que", "regex": "(?i)¿sab[íi]as que", "nota": "gancho gastado"},
    {"id": "gancho-imagina", "regex": "(?i)^\\s*imagina (?:que|esto|por un momento)", "nota": "apertura de IA"},
    {"id": "viñetas-emoji", "regex": "(?m)^\\s*[✅🚀💡🔥👉✔⭐📌🎯✨]", "nota": "lista con emojis de viñeta"},
    {"id": "muro-hashtags", "regex": "(?:#\\w+\\s*){6,}", "nota": "6 o más hashtags seguidos (usa 3 a 5)"},
    {"id": "gritos", "regex": "\\b[A-ZÁÉÍÓÚÑ]{3,}(?:\\s+[A-ZÁÉÍÓÚÑ]{3,}){2,}", "nota": "3 o más palabras en mayúsculas seguidas"},
    {"id": "y-eso-no-es-todo", "regex": "(?i)\\by eso no es todo\\b", "nota": "muletilla de infomercial"},
    {"id": "aqui-te-va", "regex": "(?i)\\baqu[íi] (?:te va|tienes|te dejo) \\w+ (?:tips|consejos|claves|pasos|formas|razones|herramientas)\\b", "nota": "apertura de listicle genérica; sirve si abre con un dato tuyo"}
